# ── WhatsApp groups to watch ─────────────────────────────────────
# Comma-separated list of group JIDs, e.g. "120363021234567890@g.us,120363029876543210@g.us"
# Leave empty on first run — the listener will print every group's name + JID
# it sees a message from ("discovery mode"), so you can copy the right ones here.
GROUP_JIDS=

# ── Parser (same Netlify function parser.html's image upload calls) ──────
# Full URL to the deployed /.netlify/functions/parse proxy.
PARSE_FUNCTION_URL=https://goodpapaya-operations.netlify.app/.netlify/functions/parse

# ── Supabase (for writing into whatsapp_parsed_orders only — the listener
# never calls Supabase edge functions directly, and never touches orders/
# order_items; that only happens when a human clicks "Push to operations"
# on the parser page's Live tab) ───────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # Settings → API → service_role (bypasses RLS)

# ── Batching ──────────────────────────────────────────────────────
# How long to wait after a group's first unflushed message before sending
# the batch to the parser (milliseconds). Keeps one Claude call per burst
# of messages instead of one per message.
BATCH_WINDOW_MS=45000

# ── First-run linking ─────────────────────────────────────────────
# Set this to link via a typed pairing code instead of scanning a QR —
# avoids WhatsApp's "QR refs attempts ended" failure entirely. Digits only,
# country code first, no + or spaces (e.g. 919876543210 for India).
# Leave empty to use the QR flow instead. Once linked, this can be removed —
# it's only read when this device isn't registered yet.
PAIRING_PHONE_NUMBER=
