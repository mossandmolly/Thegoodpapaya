{% comment %} Checkout page {% endcomment %}
<style>
.pay-methods {
  display: grid; grid-template-columns: 1fr 1fr; gap: .65rem;
  margin-bottom: 0;
}
.pay-method {
  display: flex; flex-direction: column; align-items: center; gap: .3rem;
  padding: .85rem .5rem;
  border: 2px solid var(--border); border-radius: 10px;
  cursor: pointer; transition: all .15s; background: none; width: 100%;
}
.pay-method.active { border-color: var(--green); background: var(--green-pale); }
.pay-method-icon  { font-size: 1.5rem; line-height: 1; }
.pay-method-label { font-size: .82rem; font-weight: 700; color: var(--text); }
.pay-method-sub   { font-size: .7rem; color: var(--muted); }
.pay-method.active .pay-method-label { color: var(--green); }

.co-field {
  width: 100%; padding: .6rem .85rem;
  border: 1.5px solid var(--border); border-radius: 7px;
  font-size: .95rem; font-family: inherit; outline: none;
  transition: border-color .15s; resize: vertical; background: #fff;
}
.co-field:focus { border-color: var(--green-light); }

/* Checkout cart table */
.checkout-table {
  width: 100%; border-collapse: collapse; font-size: .86rem; margin-bottom: .5rem;
}
.checkout-table th {
  text-align: left; padding: .3rem .4rem;
  border-bottom: 2px solid var(--border);
  color: var(--muted); font-size: .7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .04em;
}
.checkout-table td { padding: .5rem .4rem; border-bottom: 1px solid var(--border); vertical-align: top; }
.checkout-table tbody tr:last-child td { border-bottom: none; }
.co-num  { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.co-qty  { color: var(--muted); }
.co-item-name  { font-weight: 600; }
.co-item-pills { font-size: .72rem; color: var(--muted); margin-top: .15rem; }
.co-item-notes { font-size: .72rem; color: var(--muted); font-style: italic; margin-top: .1rem; }
.ci-remove {
  border: none; background: none; cursor: pointer;
  color: var(--muted); font-size: .7rem; padding: .15rem .3rem;
  border-radius: 4px; line-height: 1; display: block; margin: 0 auto;
}
.ci-remove:hover { background: #fee2e2; color: #dc2626; }
</style>

<div class="checkout-wrap">
  <h1 class="checkout-title">Your Order</h1>

  <!-- Cart summary -->
  <div class="card checkout-section">
    <div class="checkout-section-title" style="display:flex;justify-content:space-between;align-items:center">
      Order summary
      <a href="/" style="font-size:.75rem;font-weight:500;color:var(--green);text-transform:none;letter-spacing:0">← Edit items</a>
    </div>
    <div id="checkout-items"></div>
    <div class="checkout-total-row">
      <span>Total</span>
      <strong id="checkout-total" style="color:var(--green)">₹0</strong>
    </div>
  </div>

  <!-- Delivery details -->
  <div class="card checkout-section">
    <div class="checkout-section-title">Delivery details</div>

    <div class="form-group">
      <label>Mobile number</label>
      <div class="phone-input-wrap">
        <span class="phone-prefix">+91</span>
        <input type="tel" id="co-phone" placeholder="9876543210"
          maxlength="10" inputmode="numeric" autocomplete="tel"
          style="border:none;outline:none;padding:.6rem .75rem;font-size:.95rem;width:100%;background:transparent">
      </div>
    </div>

    <div class="form-group">
      <label>Community name</label>
      <input class="co-field" type="text" id="co-community"
        placeholder="e.g. APR Villas, Brigade Meadows">
    </div>

    <div class="form-group" style="margin-bottom:0">
      <label>Door / flat number</label>
      <input class="co-field" type="text" id="co-door"
        placeholder="e.g. 83, B-204">
    </div>
  </div>

  <!-- Order notes -->
  <div class="card checkout-section" style="padding-bottom:1rem">
    <div class="checkout-section-title">Special instructions
      <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted)"> (optional)</span>
    </div>
    <input class="co-field" type="text" id="co-notes"
      placeholder="e.g. Leave at door, call before delivery…">
  </div>

  <!-- Payment method -->
  <div class="card checkout-section">
    <div class="checkout-section-title">Payment method</div>
    <div class="pay-methods">
      <button class="pay-method active" id="pm-online" onclick="selectPayment('online')">
        <span class="pay-method-icon">💳</span>
        <span class="pay-method-label">Pay Online</span>
        <span class="pay-method-sub">UPI · Card · Netbanking</span>
      </button>
      <button class="pay-method" id="pm-cod" onclick="selectPayment('cod')">
        <span class="pay-method-icon">💵</span>
        <span class="pay-method-label">Cash on Delivery</span>
        <span class="pay-method-sub">Pay when delivered</span>
      </button>
    </div>
  </div>

  <div id="co-error" class="error-msg" style="margin-bottom:.75rem;min-height:1.2rem"></div>

  <button class="btn btn-primary" id="pay-btn" onclick="submitOrder()" style="font-size:1rem;padding:.8rem">
    Pay Online
  </button>

  <p id="pay-note" style="text-align:center;font-size:.78rem;color:var(--muted);margin-top:.65rem">
    You'll be redirected to a secure payment page
  </p>

  <p style="text-align:center;font-size:.75rem;color:var(--muted);margin-top:1.5rem">
    By placing your order you agree to our
    <a href="/pages/terms" style="color:var(--green)">Terms</a> &amp;
    <a href="/pages/refund" style="color:var(--green)">Refund policy</a>
  </p>
</div>

<script src="{{ 'checkout.js' | asset_url }}" defer></script>
