# ── Zoho ──────────────────────────────────────
# Create a Server-based app in Zoho API Console → https://api-console.zoho.in
# Grant scope: ZohoBooks.invoices.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=          # one-time: run `node zoho-auth.js` to get this
ZOHO_ORGANIZATION_ID=        # Zoho Books org ID (Settings → Organisation Profile)
ZOHO_BASE_URL=https://www.zohoapis.in/books/v3

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # Settings → API → service_role (bypasses RLS)

# ── Razorpay ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Sync config ───────────────────────────────
SYNC_INTERVAL_MINUTES=5
SYNC_LOOKBACK_MINUTES=10     # fetch invoices modified in last N minutes (overlap for safety)
